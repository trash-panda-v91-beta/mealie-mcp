import "package://github.com/jdx/hk/releases/download/v1.54.1/hk@1.54.1#/Builtins.pkl"
amends "package://github.com/jdx/hk/releases/download/v1.54.1/hk@1.54.1#/Config.pkl"

fail_fast = false

local linters = new Mapping<String, Step> {
  ["actionlint"] = Builtins.actionlint
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["ruff"] = Builtins.ruff
  ["ruff-format"] = Builtins.ruff_format
  ["rumdl"] = Builtins.rumdl
  ["tombi"] = Builtins.tombi
  ["tombi-format"] = Builtins.tombi_format
  ["ty"] = Builtins.ty
  ["yamlfmt"] = Builtins.yamlfmt
  ["yamllint"] = Builtins.yamllint
}

hooks {
  ["check"] {
    fix = false
    steps = linters
  }
  ["fix"] {
    fix = true
    stash = "none"
    steps = linters
  }
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
}
